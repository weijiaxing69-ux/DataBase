db_host=127.0.0.1
db_port=3306
db_user=root
db_password=please_replace
db_name=charging_platform_test
# 电话加密密钥（Fernet），部署时通过环境变量或本机 .env 配置
phone_encryption_key=
# 登录JWT签名密钥，至少32字符，正式环境自行生成，不要使用示例口令
auth_signing_key=
auth_token_seconds=3600
# Membership module: use dedicated keys in production and keep the same phone key as the seed fixture.
app_env=development
plate_encryption_key=
phone_hmac_key=
plate_hmac_key=
fleet_reserve_amount=50.00
